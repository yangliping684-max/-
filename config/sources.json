    {
      "id": "anthropic-jobs",
      "name": "Anthropic 公开职位（Greenhouse）",
      "type": "api",
      "url": "https://boards-api.greenhouse.io/v1/boards/anthropic/jobs",
      "category": "jobs",
      "keywords": [
        "intern",
        "internship",
        "new grad",
        "university",
        "early career"
      ],
      "priority": 4,
      "credibility": "official",
      "max_items": 2000,
      "baseline_items": 10,
      "api": {
        "items_path": "jobs",
        "id_field": "id",
        "title_field": "title",
        "url_field": "absolute_url",
        "published_field": "first_published",
        "updated_field": "updated_at",
        "extra_fields": {
          "location": "location.name"
        },
        "total_path": "meta.total"
      },
      "notes": "Greenhouse 公开职位接口（为第三方嵌入职位列表提供的官方 API）。仅展示接口返回的字段，不推断学历要求或截止日期。",
      "profile": "jobs",
      "company": "Anthropic",
      "industry": "人工智能"
    },
    {
      "id": "bosch-china-jobs",
      "name": "博世中国 公开职位（SmartRecruiters）",
      "type": "api",
      "url": "https://api.smartrecruiters.com/v1/companies/BoschGroup/postings?country=cn&limit=100",
      "category": "jobs",
      "profile": "jobs",
      "company": "博世 Bosch",
      "industry": "汽车零部件 / 制造业",
      "keywords": [
        "供应链",
        "物流",
        "采购",
        "PMC",
        "物料控制",
        "生产计划",
        "库存管理",
        "仓储",
        "需求计划",
        "管培生"
      ],
      "require_keywords": true,
      "priority": 4,
      "credibility": "official",
      "max_items": 2000,
      "baseline_items": 20,
      "api": {
        "items_path": "content",
        "id_field": "id",
        "title_field": "name",
        "url_template": "https://jobs.smartrecruiters.com/BoschGroup/{id}",
        "published_field": "releasedDate",
        "total_path": "totalFound",
        "pagination": {
          "offset_param": "offset",
          "page_size": 100,
          "max_pages": 20
        },
        "extra_fields": {
          "company": "company.name",
          "location": "location.fullLocation",
          "employment_type": "typeOfEmployment.label",
          "experience_level": "experienceLevel.label",
          "function": "function.label",
          "industry": "industry.label",
          "position_type": "customField[fieldLabel=Position type].valueLabel",
          "legal_entity": "customField[fieldLabel=Legal Entity].valueLabel"
        }
      },
      "notes": "SmartRecruiters 官方公开 Posting API（无需认证）。逐页读取全部中国区职位，再用供应链类同义词组在本地筛选；接口的 q 参数是宽松全文检索，不适合直接筛选。releasedDate 为职位发布时间。"
    },
