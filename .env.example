# 知更 ChangeRadar — environment variables
#
# ⚠️ Never commit a real .env file. In GitHub Actions, configure these as
#    Settings → Secrets and variables → Actions. Secrets are never sent to the browser
#    and are never written to data/ (there is a test that checks this).

# Optional. GitHub token used for the GitHub REST API (releases) and optional Issue
# notifications. Inside GitHub Actions this is provided automatically as
# secrets.GITHUB_TOKEN — you do NOT need to create it. Locally, a fine-grained
# token with read-only public access raises the API limit from 60 to 5000 req/h.
GITHUB_TOKEN=

# Set automatically in Actions ("owner/repo"); only needed locally for Issue notifications.
GITHUB_REPOSITORY=

# Optional. User-Agent sent to monitored sites (be identifiable and polite).
CHANGERADAR_USER_AGENT="ChangeRadar/0.1 (+https://github.com/<you>/<repo>)"

# --- Not implemented yet (roadmap). Listed so you know where they will go. ---
# SMTP_HOST= / SMTP_USER= / SMTP_PASSWORD=   (email digests)
# TELEGRAM_BOT_TOKEN= / TELEGRAM_CHAT_ID=      (Telegram bot)
# WECOM_WEBHOOK_URL=                           (企业微信机器人)
# ANTHROPIC_API_KEY=                           (phase-2 AI analysis — paid API, opt-in only)
